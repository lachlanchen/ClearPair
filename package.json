{
  "name": "clearpair",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4310",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "npm run typecheck && node tools/build.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4310",
    "check": "npm run test && npm run build",
    "test:e2e": "playwright test",
    "audio": "node tools/audio-manifest.mjs",
    "native:sync": "node tools/native.mjs"
  },
  "dependencies": {
    "@clearpair/audio":"file:native/audio",
    "@capacitor/core": "8.5.1",
    "@capacitor/android": "8.5.1",
    "@capacitor/ios": "8.5.1",
    "lucide-react": "1.41.0",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.1",
    "@playwright/test": "^1.58.0",
    "@testing-library/react": "16.3.0",
    "@types/node": "24.10.1",
    "@types/react": "19.2.5",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "fake-indexeddb": "6.2.5",
    "jsdom": "27.0.0",
    "sharp": "0.34.5",
    "plist": "3.1.1",
    "typescript": "5.9.3",
    "vite": "7.2.4",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "5.0.0"
  }
}
